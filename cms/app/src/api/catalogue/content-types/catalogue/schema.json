{
  "kind": "singleType",
  "collectionName": "catalogues",
  "info": {
    "singularName": "catalogue",
    "pluralName": "catalogues",
    "displayName": "Catalogue"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": { "localized": true }
  },
  "attributes": {
    "main_title":    { "type": "string", "required": true, "pluginOptions": { "i18n": { "localized": true } } },
    "main_subtitle": { "type": "text",   "pluginOptions": { "i18n": { "localized": true } } },
    "main_button":   { "type": "string", "pluginOptions": { "i18n": { "localized": true } } },
    "main_catalogue": {
      "type": "media", "multiple": false, "allowedTypes": ["files"],
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "main_cover": {
      "type": "media", "multiple": false, "allowedTypes": ["images"],
      "pluginOptions": { "i18n": { "localized": false } }
    },

    "section_title":    { "type": "string", "pluginOptions": { "i18n": { "localized": true } } },
    "section_subtitle": { "type": "text",   "pluginOptions": { "i18n": { "localized": true } } },

    "catalogues": {
      "type": "component",
      "repeatable": true,
      "component": "catalogue.catalogue-item",
      "pluginOptions": { "i18n": { "localized": true } }
    },

    "contact_title":    { "type": "string", "pluginOptions": { "i18n": { "localized": true } } },
    "contact_subtitle": { "type": "text",   "pluginOptions": { "i18n": { "localized": true } } },
    "contact_button":   { "type": "string", "pluginOptions": { "i18n": { "localized": true } } }
  }
}
