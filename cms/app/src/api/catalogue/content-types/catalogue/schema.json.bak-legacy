    "catalogue1_button":   { "type": "string", "pluginOptions": { "i18n": { "localized": true } } },
    "catalogue1":          { "type": "media", "multiple": false, "allowedTypes": ["files"], "pluginOptions": { "i18n": { "localized": false } } },
    "catalogue1_img":      { "type": "media", "multiple": false, "allowedTypes": ["images"], "pluginOptions": { "i18n": { "localized": false } } },
    "catalogue2_title":    { "type": "string", "pluginOptions": { "i18n": { "localized": true } } },
    "catalogue2_subtitle": { "type": "text",   "pluginOptions": { "i18n": { "localized": true } } },
    "catalogue2_button":   { "type": "string", "pluginOptions": { "i18n": { "localized": true } } },
    "catalogue2":          { "type": "media", "multiple": false, "allowedTypes": ["files"], "pluginOptions": { "i18n": { "localized": false } } },
    "catalogue2_img":      { "type": "media", "multiple": false, "allowedTypes": ["images"], "pluginOptions": { "i18n": { "localized": false } } },
    "catalogue3_title":    { "type": "string", "pluginOptions": { "i18n": { "localized": true } } },
    "catalogue3_subtitle": { "type": "text",   "pluginOptions": { "i18n": { "localized": true } } },
    "catalogue3_button":   { "type": "string", "pluginOptions": { "i18n": { "localized": true } } },
    "catalogue3":          { "type": "media", "multiple": false, "allowedTypes": ["files"], "pluginOptions": { "i18n": { "localized": false } } },
    "catalogue3_img":      { "type": "media", "multiple": false, "allowedTypes": ["images"], "pluginOptions": { "i18n": { "localized": false } } },
    "contact_title":       { "type": "string", "pluginOptions": { "i18n": { "localized": true } } },
    "contact_subtitle":    { "type": "text",   "pluginOptions": { "i18n": { "localized": true } } },
    "contact_button":      { "type": "string", "pluginOptions": { "i18n": { "localized": true } } }
  }
}
