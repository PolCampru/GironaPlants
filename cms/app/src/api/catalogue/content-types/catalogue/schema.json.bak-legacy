    "main_button":         { "type": "string", "pluginOptions": { "i18n": { "localized": true } } },
    "main_catalogue":      { "type": "media", "multiple": false, "allowedTypes": ["files"], "pluginOptions": { "i18n": { "localized": false } } },
    "section_title":       { "type": "string", "pluginOptions": { "i18n": { "localized": true } } },
    "section_subtitle":    { "type": "text",   "pluginOptions": { "i18n": { "localized": true } } },
