# GironaPlants — environment variables.
# Copy to .env and fill in the secrets. .env* is gitignored.
#
# Production values live on the VPS, not here:
#   /opt/gironaplants/frontend/.env  — see deploy/README.md
# The two URL variables differ between local and production; the notes below
# are the LOCAL ones.

# --- Runtime ---
NODE_ENV=development
HOST=localhost
PORT=3000

# --- Public ---
# The app fetches its own /api/strapi proxy through this, so locally it must
# be the dev server. In production it is https://gironaplants.com.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Strapi CMS ---
# The reachable public Strapi host. Note it is api.gironaplants.com, NOT
# strapi.gironaplants.com — that name has no DNS record and never had one
# (the zone is at PIMEC: dns01/dns02.pimec.net).
# In production this is http://strapi:1337, the Docker service name.
STRAPI_BASE_URL=https://api.gironaplants.com

# Host serving Strapi media (uploads); used to build absolute image URLs.
# Leave empty to fall back to https://api.gironaplants.com.
STRAPI_MEDIA_URL=https://api.gironaplants.com

# Read-only API token from the Strapi admin panel.
STRAPI_TOKEN=

# --- Email / SMTP (contact + quote form) ---
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=
MAIL_DESTINATION=

# --- App secret ---
SECRET_TOKEN=
