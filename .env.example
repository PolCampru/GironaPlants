# GironaPlants — environment variables.
# Copy to .env and fill in the secrets. .env* is gitignored.
#
# Production values live on the VPS, not here:
#   /opt/gironaplants/frontend/.env  — see deploy/README.md
# The two URL variables differ between local and production; the notes below
# are the LOCAL ones.

# --- Runtime ---
NODE_ENV=development
HOST=localhost
PORT=3000

# --- Public ---
# The app fetches its own /api/strapi proxy through this, so locally it must
# be the dev server. In production it is https://gironaplants.com.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Strapi CMS ---
# The reachable public Strapi host. Note it is api.gironaplants.com, NOT
# strapi.gironaplants.com — that name has no DNS record and never had one
# (the zone is at PIMEC: dns01/dns02.pimec.net).
# In production this is http://strapi:1337, the Docker service name.
STRAPI_BASE_URL=https://api.gironaplants.com

# Host serving Strapi media (uploads); used to build absolute image URLs.
# Leave empty to fall back to https://api.gironaplants.com.
STRAPI_MEDIA_URL=https://api.gironaplants.com

# Read-only API token from the Strapi admin panel.
STRAPI_TOKEN=

# Custom token with ONLY `create` on Quote request. The contact form stores
# every enquiry there (lib/quoteRequests.ts); STRAPI_TOKEN is read-only, so
# without this the write is rejected with a 403 and only the email goes out.
# Falls back to STRAPI_TOKEN when unset.
STRAPI_WRITE_TOKEN=

# --- Analytics (Umami, self-hosted) ---
# Website id from the Umami panel at https://gironaplants.com/stats. Public by
# design — it appears in the page source. Empty means no tracking script is
# rendered at all, which is what we want locally.
# It is inlined at build time: on the VPS it comes from UMAMI_WEBSITE_ID in
# /opt/gironaplants/.env, passed as a build arg (deploy/docker-compose.yml).
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Only for pointing at an Umami somewhere else. Defaults to /stats/script.js,
# served first-party through Caddy.
NEXT_PUBLIC_UMAMI_SRC=

# --- Email / SMTP (contact + quote form) ---
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=
MAIL_DESTINATION=

# --- App secret ---
SECRET_TOKEN=
